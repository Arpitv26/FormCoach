# Optional. A key alone does not enable paid calls. Never put this in the frontend.
OPENAI_API_KEY=
COACH_PROVIDER=fallback
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Optional visual interpretation of uploaded video; sends sampled images to OpenAI.
# Requires COACH_PROVIDER=openai and a backend key. Counts remain geometric measurements.
VISUAL_REVIEW_ENABLED=false
OPENAI_VISION_MODEL=gpt-5.4-2026-03-05
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional override, relative to apps/api (an absolute path also works).
POSE_MODEL_PATH=artifacts/models/pose_landmarker_full.task
