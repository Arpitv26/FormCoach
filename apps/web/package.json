{
  "name": "formcoach-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "contracts:generate": "node scripts/generate-types.mjs",
    "contracts:check": "node scripts/generate-types.mjs --check",
    "pose:setup": "node scripts/setup-pose.mjs --model",
    "predev": "node scripts/setup-pose.mjs",
    "prebuild": "node scripts/setup-pose.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
