# Reference only: each app reads its own local file. See docs/BEGINNER_SETUP.md.
# Backend: apps/api/.env — keep this private; no key is needed for bootstrap.
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend: apps/web/.env.local — NEXT_PUBLIC_ values are visible to everyone.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
