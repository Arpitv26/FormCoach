{
  "$defs": {
    "AnalysisResponse": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "insufficient_data",
            "not_implemented"
          ],
          "title": "Status",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "exercise": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exercise"
            },
            {
              "type": "null"
            }
          ]
        },
        "cameraQuality": {
          "$ref": "#/$defs/CameraQuality"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "metrics": {
          "$ref": "#/$defs/SessionMetrics"
        },
        "reps": {
          "items": {
            "$ref": "#/$defs/RepAnalysis"
          },
          "title": "Reps",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/TimelineEvent"
          },
          "title": "Timeline",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "scoring": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoringInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "movementObservations": {
          "items": {
            "$ref": "#/$defs/MovementObservation"
          },
          "maxItems": 240,
          "title": "Movementobservations",
          "type": "array"
        }
      },
      "required": [
        "contractVersion",
        "sessionId",
        "status",
        "provenance",
        "source",
        "exercise",
        "cameraQuality",
        "summary",
        "metrics",
        "reps",
        "issues",
        "timeline",
        "limitations",
        "scoring"
      ],
      "title": "AnalysisResponse",
      "type": "object"
    },
    "CameraQuality": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "fullBodyVisible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fullbodyvisible"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "score",
        "fullBodyVisible",
        "issues"
      ],
      "title": "CameraQuality",
      "type": "object"
    },
    "CoachRequest": {
      "additionalProperties": false,
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisResponse"
        },
        "mode": {
          "enum": [
            "summary",
            "next_set",
            "qa"
          ],
          "title": "Mode",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "responseStyle": {
          "default": "evidence",
          "enum": [
            "evidence",
            "conversation"
          ],
          "title": "Responsestyle",
          "type": "string"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/CoachTurn"
          },
          "maxItems": 12,
          "title": "History",
          "type": "array"
        }
      },
      "required": [
        "analysis",
        "mode"
      ],
      "title": "CoachRequest",
      "type": "object"
    },
    "CoachResponse": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        },
        "mode": {
          "enum": [
            "summary",
            "next_set",
            "qa"
          ],
          "title": "Mode",
          "type": "string"
        },
        "provider": {
          "enum": [
            "fallback",
            "openai"
          ],
          "title": "Provider",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "contractVersion",
        "sessionId",
        "mode",
        "provider",
        "message",
        "evidence",
        "limitations"
      ],
      "title": "CoachResponse",
      "type": "object"
    },
    "CoachTurn": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "CoachTurn",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "detail"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Exercise": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        }
      },
      "required": [
        "id",
        "name",
        "confidence"
      ],
      "title": "Exercise",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "service": {
          "const": "formcoach-api",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "status",
        "service"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "shortCue": {
          "title": "Shortcue",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "minimum": 0,
          "title": "Endms",
          "type": "integer"
        },
        "involvedJoints": {
          "items": {
            "type": "string"
          },
          "title": "Involvedjoints",
          "type": "array"
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "confidence",
        "title",
        "shortCue",
        "explanation",
        "startMs",
        "endMs",
        "involvedJoints"
      ],
      "title": "Issue",
      "type": "object"
    },
    "KeyMoment": {
      "additionalProperties": false,
      "properties": {
        "timestampMs": {
          "minimum": 0,
          "title": "Timestampms",
          "type": "integer"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "timestampMs",
        "type",
        "label"
      ],
      "title": "KeyMoment",
      "type": "object"
    },
    "LiveBatchRequest": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        },
        "exerciseHint": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercisehint"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/PoseFrame"
          },
          "maxItems": 1800,
          "title": "Frames",
          "type": "array"
        },
        "isFinal": {
          "default": false,
          "title": "Isfinal",
          "type": "boolean"
        },
        "imageWidth": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Imagewidth",
          "type": "integer"
        },
        "imageHeight": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Imageheight",
          "type": "integer"
        }
      },
      "required": [
        "sessionId",
        "frames",
        "imageWidth",
        "imageHeight"
      ],
      "title": "LiveBatchRequest",
      "type": "object"
    },
    "MovementObservation": {
      "additionalProperties": false,
      "description": "A descriptive interval independent of completed reps; policy v1, not a grade.",
      "properties": {
        "code": {
          "const": "PUSHUP_BODY_LINE_BEND",
          "title": "Code",
          "type": "string"
        },
        "ruleVersion": {
          "const": "1.0",
          "title": "Ruleversion",
          "type": "string"
        },
        "side": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Side",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "minimum": 0,
          "title": "Endms",
          "type": "integer"
        },
        "sampleCount": {
          "maximum": 1800,
          "minimum": 3,
          "title": "Samplecount",
          "type": "integer"
        },
        "minAngleDeg": {
          "exclusiveMaximum": 150,
          "minimum": 0,
          "title": "Minangledeg",
          "type": "number"
        },
        "medianAngleDeg": {
          "exclusiveMaximum": 150,
          "minimum": 0,
          "title": "Medianangledeg",
          "type": "number"
        },
        "maxAngleDeg": {
          "exclusiveMaximum": 150,
          "minimum": 0,
          "title": "Maxangledeg",
          "type": "number"
        },
        "thresholdAngleDeg": {
          "const": 150,
          "title": "Thresholdangledeg",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "ruleVersion",
        "side",
        "startMs",
        "endMs",
        "sampleCount",
        "minAngleDeg",
        "medianAngleDeg",
        "maxAngleDeg",
        "thresholdAngleDeg"
      ],
      "title": "MovementObservation",
      "type": "object"
    },
    "PoseFrame": {
      "additionalProperties": false,
      "properties": {
        "frameIndex": {
          "minimum": 0,
          "title": "Frameindex",
          "type": "integer"
        },
        "timestampMs": {
          "minimum": 0,
          "title": "Timestampms",
          "type": "integer"
        },
        "landmarks": {
          "items": {
            "$ref": "#/$defs/PoseLandmark"
          },
          "maxItems": 33,
          "title": "Landmarks",
          "type": "array"
        }
      },
      "required": [
        "frameIndex",
        "timestampMs",
        "landmarks"
      ],
      "title": "PoseFrame",
      "type": "object"
    },
    "PoseLandmark": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "maximum": 32,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z"
        },
        "visibility": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visibility"
        }
      },
      "required": [
        "index",
        "name",
        "x",
        "y"
      ],
      "title": "PoseLandmark",
      "type": "object"
    },
    "PoseTrack": {
      "additionalProperties": false,
      "properties": {
        "imageWidth": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Imagewidth",
          "type": "integer"
        },
        "imageHeight": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Imageheight",
          "type": "integer"
        },
        "durationMs": {
          "maximum": 120000,
          "minimum": 0,
          "title": "Durationms",
          "type": "integer"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/PoseFrame"
          },
          "maxItems": 1800,
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "imageWidth",
        "imageHeight",
        "durationMs",
        "frames"
      ],
      "title": "PoseTrack",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "measured",
            "synthetic",
            "placeholder"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RepAnalysis": {
      "additionalProperties": false,
      "properties": {
        "repNumber": {
          "minimum": 1,
          "title": "Repnumber",
          "type": "integer"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "minimum": 0,
          "title": "Endms",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "metrics": {
          "$ref": "#/$defs/RepMetrics"
        },
        "measurements": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Measurements",
          "type": "object"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "keyMoments": {
          "items": {
            "$ref": "#/$defs/KeyMoment"
          },
          "title": "Keymoments",
          "type": "array"
        }
      },
      "required": [
        "repNumber",
        "startMs",
        "endMs",
        "score",
        "metrics",
        "measurements",
        "issues",
        "keyMoments"
      ],
      "title": "RepAnalysis",
      "type": "object"
    },
    "RepMetrics": {
      "additionalProperties": false,
      "properties": {
        "rangeOfMotion": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rangeofmotion"
        },
        "symmetry": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symmetry"
        },
        "tempo": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tempo"
        },
        "stability": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stability"
        }
      },
      "required": [
        "rangeOfMotion",
        "symmetry",
        "tempo",
        "stability"
      ],
      "title": "RepMetrics",
      "type": "object"
    },
    "ScoringInfo": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "version",
        "method",
        "weights"
      ],
      "title": "ScoringInfo",
      "type": "object"
    },
    "SessionMetrics": {
      "additionalProperties": false,
      "properties": {
        "rangeOfMotion": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rangeofmotion"
        },
        "symmetry": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symmetry"
        },
        "tempo": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tempo"
        },
        "stability": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stability"
        },
        "consistency": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Consistency"
        }
      },
      "required": [
        "rangeOfMotion",
        "symmetry",
        "tempo",
        "stability",
        "consistency"
      ],
      "title": "SessionMetrics",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "live",
            "upload"
          ],
          "title": "Type",
          "type": "string"
        },
        "durationMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Durationms"
        }
      },
      "required": [
        "type",
        "durationMs"
      ],
      "title": "Source",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "overallScore": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overallscore"
        },
        "totalReps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Totalreps"
        },
        "primaryFocus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primaryfocus"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        }
      },
      "required": [
        "overallScore",
        "totalReps",
        "primaryFocus",
        "headline"
      ],
      "title": "Summary",
      "type": "object"
    },
    "TimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "timestampMs": {
          "minimum": 0,
          "title": "Timestampms",
          "type": "integer"
        },
        "type": {
          "enum": [
            "rep_start",
            "rep_end",
            "key_moment",
            "issue"
          ],
          "title": "Type",
          "type": "string"
        },
        "repNumber": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Repnumber"
        },
        "issueId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
